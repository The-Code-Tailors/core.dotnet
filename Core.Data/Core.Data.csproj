<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyVersion>12.0</AssemblyVersion>
        <Authors>Fabio Scagliola</Authors>
        <Copyright>Fabio Scagliola 2013</Copyright>
        <Description>The Core.Data library constitutes the heart of my framework and includes several utility classes</Description>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Nullable>enable</Nullable>
        <Product>Core.Data</Product>
        <RootNamespace>com.fabioscagliola.Core.Data</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <Title>Core.Data</Title>
        <Version>$(AssemblyVersion)</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1"/>
    </ItemGroup>

</Project>